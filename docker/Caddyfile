# ============================================================
# Caddyfile do ecossistema pvSolar
# ------------------------------------------------------------
# Roteamento por caminho (mesma origem do Web -> sem CORS):
#   http://<host>/<servidor>/*  ->  http://<servidor>:<porta interna>/*
# (handle_path remove o prefixo antes de encaminhar)
#
# Site address vem da variavel DOMAIN (.env):
#   DOMAIN=http://localhost -> HTTP local na porta 80 (default)
#   DOMAIN=:80              -> HTTP por IP (VPS sem dominio)
#   DOMAIN=exemplo.com      -> HTTPS automatico (Let's Encrypt)
# Sem o esquema "http://", o Caddy trata "localhost" como HTTPS
# com certificado interno (redirect :80 -> :443) - caddy v2.11.6.
#
# NOTA: o parser do Caddy NAO aceita conteudo apos '{' na mesma
# linha ("Unexpected next token after '{' on same line") - por isso
# todos os blocos abrem com '{' no fim da linha. Validado na CI
# com `caddy validate` antes de subir a stack.
#
# SCADA (5000) nao entra aqui: e protocolo pvBrowser TCP puro,
# publicado diretamente na porta 5000 do host.
# ============================================================

{$DOMAIN} {
	# --- Servicos HTTP do ecossistema ---
	handle_path /gateway/* {
		reverse_proxy gateway:8000
	}
	handle_path /analytics/* {
		reverse_proxy analytics:8001
	}
	handle_path /reports/* {
		reverse_proxy reports:8002
	}
	handle_path /fleet/* {
		reverse_proxy fleet:8003
	}
	handle_path /alert/* {
		reverse_proxy alert:8004
	}
	handle_path /grid/* {
		reverse_proxy grid:8005
	}
	handle_path /twin/* {
		reverse_proxy twin:8006
	}
	handle_path /auth/* {
		reverse_proxy auth:8007
	}
	handle_path /backup/* {
		reverse_proxy backup:8008
	}
	handle_path /scheduler/* {
		reverse_proxy scheduler:8009
	}
	handle_path /exporter/* {
		reverse_proxy exporter:8010
	}

	# --- pvSolar Web (interface) ---
	handle {
		reverse_proxy web:3001
	}
}
