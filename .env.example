# ============================================================
# pvSolar - exemplo de variaveis de ambiente (copie para .env)
#   cp .env.example .env
#
# Todos os valores tem default no docker-compose.yml - o .env e
# opcional e serve para sobrescrever.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pvsolar_dev

# ---------- Caddy (entrada unica) ----------
# localhost        -> HTTP local na porta 80
# :80              -> HTTP por IP (VPS sem dominio)
# exemplo.com      -> HTTPS automatico (Let's Encrypt)
DOMAIN=localhost

# ---------- Timezone ----------
TZ=America/Sao_Paulo

# ---------- pvSolar Web (build da imagem) ----------
# Padrao = caminhos relativos via Caddy (mesma origem, sem CORS).
# So altere se for servir o Web fora do Caddy.
NEXT_PUBLIC_GATEWAY_URL=/gateway
NEXT_PUBLIC_ANALYTICS_URL=/analytics
NEXT_PUBLIC_SCADA_URL=http://localhost:5000
NEXT_PUBLIC_REPORTS_URL=/reports
NEXT_PUBLIC_FLEET_URL=/fleet
NEXT_PUBLIC_ALERT_URL=/alert
NEXT_PUBLIC_GRID_URL=/grid
NEXT_PUBLIC_TWIN_URL=/twin
NEXT_PUBLIC_AUTH_URL=/auth
